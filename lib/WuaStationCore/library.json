  "license": "MIT",
  "authors": [
    {
      "name": "Wualabs LTD",
      "url": "https://wualeds.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WuaLeds/WuaStation-Mini-firmware.git"
  },
  "frameworks": "arduino",
  "platforms": "espressif32",
  "dependencies": [
    {
      "owner": "fastled",
      "name": "FastLED",
      "version": "3.10.3"
    },
    {
      "owner": "adafruit",
      "name": "Adafruit GFX Library",
      "version": "^1.12.6"
    },
    {
      "owner": "adafruit",
      "name": "Adafruit BusIO",
      "version": "^1.17.0"
    },
    {
      "name": "WuaDisplay-LMX",
      "version": "https://github.com/WuaLeds/WuaDisplay-LMX.git#1d8f55554a048c2d1f6ad2cfd5ebb3dcfe3f7793"
    },
    {
      "owner": "bblanchon",
      "name": "ArduinoJson",
      "version": "^7.4.2"
    },
    {
      "owner": "adafruit",
      "name": "Adafruit Unified Sensor",
      "version": "^1.1.14"
    },
    {
      "owner": "adafruit",
      "name": "Adafruit BME280 Library",
      "version": "^2.2.4"
    }
  ]
